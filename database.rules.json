{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "casos": {
          ".indexOn": ["createdAt", "updatedAt", "placa"]
        }
      }
    }
  }
}